{
  "description": "Guardrails: block commits that add something that looks like a secret, and commits made directly on the main branch.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check-staged-secrets.sh"], "timeout": 30 },
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/no-commit-on-main.sh"], "timeout": 10 }
        ]
      }
    ]
  }
}
