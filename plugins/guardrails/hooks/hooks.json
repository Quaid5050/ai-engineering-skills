{
  "description": "Advisory command preflight; actual-index secret patterns and branch checks. Host permissions enforce execution boundaries.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/check-staged-secrets.sh"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/no-commit-on-main.sh"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
